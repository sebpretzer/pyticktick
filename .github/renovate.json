{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "customManagers:githubActionsVersions",
    ":automergeDigest",
    ":automergeMinor",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",
    ":rebaseStalePrs"
  ],
  "timezone": "America/Chicago",
  "schedule": ["* * * * 0,5,6"],
  "automergeSchedule": ["* * * * 0,5,6"],
  "updateNotScheduled": false,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "automerge": false
  },
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "internalChecksAsSuccess": true,
  "dependencyDashboard": true,
  "assignees": ["sebpretzer"],
  "labels": ["renovate"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 0-5 * * 5"]
  },
  "pep621": {
    "enabled": true,
    "automerge": true
  },
  "github-actions": {
    "enabled": true,
    "automerge": true
  },
  "pre-commit": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "TODO: remove when this is resolved: https://github.com/renovatebot/renovate/issues/45236",
      "matchUpdateTypes": ["digest", "pinDigest", "lockFileMaintenance"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Only allow major standard upgrades for renovatebot/pre-commit-hooks",
      "matchDepNames": ["renovatebot/pre-commit-hooks"],
      "matchUpdateTypes": ["minor", "patch", "pin"],
      "enabled": false
    },
    {
      "description": "Group pre-commit hook updates into one PR",
      "matchManagers": ["pre-commit"],
      "matchUpdateTypes": ["major", "minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "Group GitHub Actions updates into one PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major", "minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group Python dependency updates into one PR",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["major", "minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "Python dependencies"
    }
  ],
  "ignoreDeps": ["python"]
}
