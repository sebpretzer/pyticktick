{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "customManagers:githubActionsVersions",
    ":automergeDigest",
    ":automergePatch",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",
    ":rebaseStalePrs"
  ],
  "timezone": "America/Chicago",
  "schedule": ["* 0-5 * * *"],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "internalChecksAsSuccess": true,
  "dependencyDashboard": true,
  "assignees": ["sebpretzer"],
  "labels": ["renovate"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "pep621": {
    "enabled": true,
    "automerge": true
  },
  "github-actions": {
    "enabled": true,
    "automerge": true
  },
  "pre-commit": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "TODO: remove when this is resolved: https://github.com/renovatebot/renovate/issues/45236",
      "matchUpdateTypes": ["digest", "pinDigest", "lockFileMaintenance"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Only allow major standard upgrades for renovatebot/pre-commit-hooks",
      "matchDepNames": ["renovatebot/pre-commit-hooks"],
      "matchUpdateTypes": ["minor", "patch", "pin"],
      "enabled": false
    }
  ],
  "ignoreDeps": ["python"]
}
